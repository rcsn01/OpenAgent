{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "openagent",
  "description": "Frontend shell for OpenAgent",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.13",
  "scripts": {
    "dev:web": "bun --cwd packages/app dev",
    "dev:desktop": "bun --cwd packages/desktop dev",
    "build:web": "bun --cwd packages/app build",
    "build:desktop": "bun --cwd packages/desktop build",
    "typecheck": "bun turbo typecheck",
    "lint": "oxlint",
    "prepare": "husky",
    "test": "echo 'run package-specific tests' && exit 1"
  },
  "workspaces": {
    "packages": ["packages/app", "packages/desktop", "packages/server", "packages/ui"],
    "catalog": {
      "@kobalte/core": "0.13.11",
      "@pierre/diffs": "1.1.0-beta.18",
      "@playwright/test": "1.59.1",
      "@sentry/solid": "10.36.0",
      "@sentry/vite-plugin": "4.6.0",
      "@solid-primitives/storage": "4.3.3",
      "@solidjs/meta": "0.29.4",
      "@solidjs/router": "0.15.4",
      "@tailwindcss/vite": "4.1.11",
      "@tsconfig/bun": "1.0.9",
      "@tsconfig/node22": "22.0.2",
      "@types/bun": "1.3.12",
      "@types/luxon": "3.7.1",
      "@types/node": "24.12.2",
      "@typescript/native-preview": "7.0.0-dev.20251207.1",
      "diff": "8.0.2",
      "dompurify": "3.3.1",
      "fuzzysort": "3.1.0",
      "luxon": "3.6.1",
      "marked": "17.0.1",
      "marked-shiki": "1.2.1",
      "remeda": "2.26.0",
      "remend": "1.3.0",
      "semver": "7.7.4",
      "shiki": "3.20.0",
      "solid-js": "1.9.10",
      "solid-list": "0.3.0",
      "tailwindcss": "4.1.11",
      "typescript": "5.8.2",
      "virtua": "0.49.1",
      "vite": "7.1.4",
      "vite-plugin-solid": "2.11.10",
      "zod": "4.1.8"
    }
  },
  "devDependencies": {
    "@tsconfig/bun": "catalog:",
    "@typescript/native-preview": "catalog:",
    "husky": "9.1.7",
    "oxlint": "1.60.0",
    "oxlint-tsgolint": "0.21.0",
    "prettier": "3.6.2",
    "turbo": "2.8.13",
    "typescript": "catalog:"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/rcsn01/OpenAgent.git"
  },
  "license": "MIT",
  "prettier": {
    "semi": false,
    "printWidth": 120
  },
  "trustedDependencies": ["esbuild", "electron", "protobufjs"],
  "overrides": {
    "@types/bun": "catalog:",
    "@types/node": "catalog:"
  },
  "patchedDependencies": {
    "solid-js@1.9.10": "patches/solid-js@1.9.10.patch"
  }
}
